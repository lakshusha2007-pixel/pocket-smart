# Google Gemini API Key (Get free key from https://aistudio.google.com/ or Google Cloud Console)
GEMINI_API_KEY=AIzaSy...

# Secret key for session encryption & JWT token signing
SESSION_SECRET=pocketsmart-secure-session-key-random-string-9912

# Server Port (Default: 8080 or assigned dynamically by Render/Cloud host)
PORT=8080

# Firebase Cloud Firestore Credentials (Option 1: Path to service account JSON file)
# Download from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# Firebase Cloud Firestore Credentials (Option 2: Raw JSON string, useful for Vercel / Render environment variables)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"..."}
